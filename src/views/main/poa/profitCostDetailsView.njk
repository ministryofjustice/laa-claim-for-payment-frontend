{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% extends "base.njk" %}

{% set title = t('pages.profitCostDetails.title') %}
{% set showBackLink = true %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <h1 class="govuk-heading-l">{{ t('pages.profitCostDetails.title') }}</h1>

      {% if vm.errorSummary %}
        {{ govukErrorSummary(vm.errorSummary | translate) }}
      {% endif %}

      <form method="post">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">

        {{ govukRadios(vm.courtTypeRadios | translate) }}

        {{ govukRadios(vm.clientStatusRadios | translate) }}

        {{ govukRadios(vm.firstSolicitorRadios | translate) }}

        {{ govukRadios(vm.transferOfSolicitorRadios | translate) }}

        <div class="govuk-button-group">
          {{ govukButton({
            text: t("common.saveAndContinue")
          }) }}
          <a class="govuk-button govuk-button--secondary" href="#">{{ t('common.saveAndComeBackLater') }}</a>
        </div>
      </form>
    </div>
  </div>
{% endblock %}