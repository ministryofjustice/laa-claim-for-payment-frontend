{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% extends "base.njk" %}

{% set title = vm.title | translate %}
{% set showBackLink = true %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% if vm.errorSummary %}
        {{ govukErrorSummary(vm.errorSummary | translate) }}
      {% endif %}

      <form method="post">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">

        <h1 class="govuk-heading-l">
          {{ t('pages.escapingFixedFee.title') }}
        </h1>

        <p class="govuk-body">
          {{ t('pages.escapingFixedFee.p1') }}
        </p>

        <ul class="govuk-list govuk-list--bullet">
          <li>{{ t('pages.escapingFixedFee.ul1') }}</li>
          <li>{{ t('pages.escapingFixedFee.ul2') }}</li>
          <li>{{ t('pages.escapingFixedFee.ul3') }}</li>
        </ul>

        <p class="govuk-body">
          {{ t('pages.escapingFixedFee.p2') }}
        </p>

        <p class="govuk-body">
          {{ t('pages.escapingFixedFee.p3') }}
        </p>

        {{ govukRadios(vm.radios | translate) }}

        {{ govukButton({
          text: t("common.saveAndContinue")
        }) }}
      </form>

    </div>
  </div>
{% endblock %}