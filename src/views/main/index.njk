{% extends "base.njk" %}

{%- from "govuk/components/table/macro.njk" import govukTable -%}
{% from "govuk/components/tabs/macro.njk" import govukTabs %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{%- from "moj/components/sub-navigation/macro.njk" import mojSubNavigation -%}
{%- from "moj/components/pagination/macro.njk" import mojPagination -%}

{% set title = t('pages.home.title') %}

{% block content %}
  <h1 class="govuk-heading-xl">{{ t('pages.home.title') }}</h1>

  <form method="post">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">

    <div class="govuk-button-group">
      {{ govukButton({
        text: t('pages.home.actions.import'),
        name: "action",
        value: "import"
      }) }}
      {{ govukButton({
        text: t('pages.home.actions.create'),
        name: "action",
        value: "create",
        classes: "govuk-button--secondary"
      }) }}
      {{ govukButton({
        text: t('pages.home.actions.poa'),
        name: "action",
        value: "poa",
        classes: "govuk-button--secondary"
      }) }}
    </div>
  </form>

  {{ mojSubNavigation({
    label: "Sub navigation",
    items: [
      {
        text: "Submitted",
        href: "#1",
        active: true
      },
      {
        text: "In progress",
        href: "#2"
      }
    ]
  }) }}

  <h2 class="govuk-heading-m">Submitted</h2>

  {{ govukTable(table | translate) }}

  {{ mojPagination(pagination) }}

{% endblock %}